# Environment
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=Project_shivshakti.settings
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database
DATABASE_URL=
POSTGRES_CONN_MAX_AGE=60
REDIS_URL=

# Media/static
DJANGO_MEDIA_ROOT=
DJANGO_SERVE_MEDIA=true

# Admin hardening
DJANGO_ADMIN_URL=secure-control-panel/
DJANGO_ADMIN_LOGIN_URL=admin-login/
DJANGO_ADMIN_LOGIN_RATELIMIT=5/m
DJANGO_ALLOWED_ADMIN_IPS=127.0.0.1
DJANGO_USE_X_FORWARDED_FOR=false

# Email
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@shivshaktitraders.com
DJANGO_ADMIN_NOTIFICATION_EMAIL=admin@shivshaktitraders.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=30

# Rate limiting
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=300
ENQUIRY_RATE_LIMIT_MAX_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# API settings
API_PAGE_SIZE=12
API_THROTTLE_ANON=60/min
API_THROTTLE_USER=120/min
API_THROTTLE_PRODUCTS=120/min
API_THROTTLE_ENQUIRIES=30/min

# JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=true
JWT_BLACKLIST_AFTER_ROTATION=true
JWT_SIGNING_KEY=

# OpenAPI
API_TITLE=Shivshakti Traders API
API_VERSION=v1
API_DESCRIPTION=REST API for Shivshakti Traders products and enquiries. Use JWT Bearer token for protected endpoints.

# reCAPTCHA
DJANGO_RECAPTCHA_ENABLED=false
DJANGO_RECAPTCHA_SITE_KEY=
DJANGO_RECAPTCHA_SECRET_KEY=

# Celery
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backup
DB_BACKUP_DIR=./backups

# Logging
DJANGO_LOG_LEVEL=INFO





